{
  "manifestVersion": 2,
  "publisher": "faisalmuhammad",
  "id": "graphiql",
  "name": "GraphiQL for Orca",
  "version": "0.1.2",
  "description": "A GraphiQL integration for Orca with saved sessions, named environments, schema exploration, and secure authentication.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "contributes": {
    "hooks": [{ "event": "editor.save.before" }],
    "customEditors": [
      {
        "id": "graphiql",
        "title": "GraphQL IDE",
        "extensions": [
          ".graphiql",
          ".graphiql.json"
        ],
        "entry": "editor/index.html",
        "frame": "isolated",
        "icon": "images/icon.png"
      }
    ],
    "newFiles": [
      {
        "id": "session",
        "title": "New GraphiQL Session",
        "extension": ".graphiql",
        "template": "templates/empty.graphiql",
        "icon": "images/icon.png"
      }
    ],
    "panels": [
      {
        "id": "explorer",
        "title": "GraphiQL Explorer",
        "icon": "code",
        "entry": "activity/index.html",
        "ui": "html"
      }
    ]
  },
  "main": "worker/main.mjs",
  "license": "MIT",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    }
  ],
  "author": {
    "name": "faisalmuhammad",
    "url": "https://github.com/faisalmuhammad"
  },
  "repository": "https://github.com/faisalmuhammad/orca-graphiql",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "Large Countries query/result editor on the left, with the GraphQL logo and glowing GraphiQL for Orca title on the right"
  },
  "screenshots": [
    {
      "path": "images/schema-browser.png",
      "alt": "GraphiQL schema documentation and Countries query/result in Orca",
      "caption": "Schema documentation and query results",
      "theme": "dark"
    },
    {
      "path": "images/connection-settings.png",
      "alt": "GraphiQL connection settings for the Countries endpoint in Orca",
      "caption": "Endpoint and authentication settings",
      "theme": "dark"
    },
    {
      "path": "images/autocomplete.png",
      "alt": "Schema-aware GraphQL field completion in Orca's GraphiQL editor",
      "caption": "Schema-aware autocomplete",
      "theme": "dark"
    }
  ]
}
